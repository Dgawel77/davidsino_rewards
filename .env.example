DATABASE_URL=postgresql://davidsino:davidsino_pass@localhost:5432/davidsino
SECRET_KEY=change-this-to-a-random-string
ADMIN_PIN=1234
WORKER_PIN=5678

# ============================================================
# Deposit methods
# ============================================================
# Leave a value blank and that method simply won't appear in the app.
# Nothing here is custodial: players send funds directly to these addresses
# and a dealer confirms receipt in the app, which is what credits points.

# --- Crypto (paste YOUR receive addresses) ---
BTC_ADDRESS=
ETH_ADDRESS=
LTC_ADDRESS=
SOL_ADDRESS=
USDT_ADDRESS=
USDC_ADDRESS=
# Which chain your USDT/USDC address lives on. Shown to the player so they
# don't send on the wrong network and lose the funds.
USDT_NETWORK=TRC-20
USDC_NETWORK=ERC-20

# --- Payment handles (Apple Pay / Google Pay work as funding sources here) ---
VENMO_HANDLE=
CASHAPP_HANDLE=
PAYPAL_ME=
ZELLE_HANDLE=

# --- Deposit limits & pricing ---
MAX_DEPOSIT_USD=10000
# Set to 1 for an offline deployment: skips the CoinGecko price lookup, so
# players are told to send "$50 worth" instead of an exact coin amount.
PRICE_FEED_DISABLED=
